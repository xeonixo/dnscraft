{
	"name": "dnscraft-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "node scripts/gen-inlang.mjs",
		"build": "vite build",
		"prebuild": "node scripts/gen-inlang.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && node scripts/gen-inlang.mjs",
		"i18n": "node scripts/gen-inlang.mjs && paraglide-js compile --project ./.generated/project.inlang --outdir ./src/lib/paraglide --disable-async-local-storage",
		"check": "pnpm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"lint": "pnpm run i18n && eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"pretest": "node scripts/gen-inlang.mjs"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.26.0",
		"@inlang/plugin-message-format": "4.4.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"eslint": "9.39.5",
		"eslint-plugin-svelte": "3.23.1",
		"jsdom": "30.1.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
